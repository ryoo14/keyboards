/*
 * rhyn47 (split-wireless) 共通定義
 *
 * 左右で同一のドーター基板（XIAO nRF52840 Plus + 電源）を使うため、
 * kscan・matrix-transform・電池監視はここに1回だけ書く。
 * 左右差（col-offset / トラックボール）は *_left.overlay / *_right.overlay で。
 *
 * 設計書: wireless-rhyn-design.md §4, §7 / 実装ノート: zmk-implementation-notes.md §3-§5, §8
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-adc.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,battery = &vbatt_ext;
    };

    /*
     * マトリクス 4行 × 6列（片側24キー）
     * ダイオードは全キー同じ向き = col2row。外部プルアップ抵抗なし（内蔵プル使用）。
     *
     * ⚠ col2row では ROW=入力かつ内蔵プル"ダウン" / COL=出力 ACTIVE_HIGH になる
     *   （設計書 §12.7 の「内蔵プルアップ」は「外部抵抗なし」の意で読むこと）。
     *   実基板のダイオード向きが逆だったら row2col + PULL_UP / ACTIVE_LOW に変更。
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0  3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW0 = D1 / P0.03
            , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW1 = D2 / P0.28
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW2 = D3 / P0.29
            , <&gpio0  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // ROW3 = D4 / P0.04
            ;

        col-gpios
            = <&gpio0  5 GPIO_ACTIVE_HIGH>   // COL0 = D5  / P0.05
            , <&gpio1 11 GPIO_ACTIVE_HIGH>   // COL1 = D6  / P1.11
            , <&gpio1 12 GPIO_ACTIVE_HIGH>   // COL2 = D7  / P1.12
            , <&gpio1 13 GPIO_ACTIVE_HIGH>   // COL3 = D8  / P1.13
            , <&gpio1 14 GPIO_ACTIVE_HIGH>   // COL4 = D9  / P1.14
            , <&gpio1 15 GPIO_ACTIVE_HIGH>   // COL5 = D10 / P1.15
            ;
    };

    /*
     * 論理グリッド 4行 × 12列。左=列0-5 / 右=列6-11（右 overlay で col-offset=6）。
     * 右手の最下段・最内側 RC(3,6) がトラックボール位置なので map から省く。
     *   → 総キー数 47（左24 + 右23）。QMK 版 keymap.c の row3 index6 = KC_NO と一致。
     *
     * バインド順は下の map の並び順そのまま。row0=12 / row1=12 / row2=12 / row3=11。
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        //          左手 (col 0-5)                            右手 (col 6-11)
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)           RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        >;                                     /* ↑ RC(3,6) = トラックボール */
    };

    /*
     * 電池電圧監視（設計書 §4, §7 / 実装ノート §8）
     * 単4×1 の生電圧を外部分圧 1MΩ / 470kΩ で A0 (P0.02 = AIN0) に入れる。
     * power-gpios なし（常時ONの分圧、約1µA）。
     */
    vbatt_ext: vbatt_ext {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 0>;
        output-ohms = <470000>;
        full-ohms = <(1000000 + 470000)>;
    };
};

/* ボード標準のオンボード分圧（P0.31 / P0.14 制御）は使わないので止める */
&vbatt {
    status = "disabled";
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    /* AIN0 = P0.02 = D0。ビルドが通らなければこの channel@0 ごと削って
       ボード標準 vbatt と同じ「io-channels だけ」の書式に戻す（実装ノート §8）。 */
    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";              /* フルスケール 0.6V × 6 = 3.6V */
        zephyr,reference = "ADC_REF_INTERNAL";     /* 0.6V */
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
        zephyr,input-positive = <NRF_SAADC_AIN0>;
        zephyr,resolution = <12>;
    };
};
