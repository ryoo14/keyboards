if SHIELD_RHYN47_LEFT

config ZMK_KEYBOARD_NAME
    default "rhyn47"

endif

if SHIELD_RHYN47_RIGHT

config ZMK_KEYBOARD_NAME
    default "rhyn47"

# 右手をセントラル（PC と BLE 接続する親）にする。
# トラボが右手にあるので、ポインタの高頻度データを分割リンクに流さずに済む。
config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_RHYN47_LEFT || SHIELD_RHYN47_RIGHT

config ZMK_SPLIT
    default y

endif
